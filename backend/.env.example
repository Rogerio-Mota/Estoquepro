# Django
# Gere uma chave local unica para o seu notebook.
# Exemplo:
# python -c "from secrets import token_urlsafe; print(token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-unique-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_SERVE_STATIC=true
DJANGO_SERVE_MEDIA=true
DJANGO_SECURE_SSL_REDIRECT=false
# Em producao, habilite tambem os headers abaixo.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false
# Em producao, mantenha false e ajuste os dominios reais.
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=seu-backend.exemplo.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://seu-frontend.exemplo.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-frontend.exemplo.com,https://seu-backend.exemplo.com
# PORT=8000
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=3600

# Banco de dados
# Use uma das abordagens abaixo.

# 1) URL unica do PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estoquepro
# 2) Campos separados
POSTGRES_DB=estoquepro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# Provisionamento opcional do administrador principal
# DJANGO_ADMIN_USERNAME=admin
# DJANGO_ADMIN_PASSWORD=change-me
# DJANGO_ADMIN_SUBSTITUIR=false

@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome

title EstoquePro - Diagrama de Casos de Uso

actor "Visitante" as Visitante
actor "Funcionário" as Funcionario
actor "Administrador" as Admin

Admin --|> Funcionario

rectangle "EstoquePro" {
  usecase "Consultar primeiro acesso" as UC_PrimeiroAcesso
  usecase "Criar administrador inicial" as UC_CriarAdminInicial
  usecase "Realizar login" as UC_Login

  usecase "Visualizar painel" as UC_Painel
  usecase "Consultar produtos" as UC_Produtos
  usecase "Consultar estoque baixo" as UC_EstoqueBaixo
  usecase "Consultar movimentações" as UC_Movimentacoes
  usecase "Consultar relatórios" as UC_Relatorios
  usecase "Consultar fornecedores" as UC_ConsultarFornecedores
  usecase "Consultar vendas" as UC_ConsultarVendas

  usecase "Registrar entrada de estoque" as UC_Entrada
  usecase "Registrar saída de estoque" as UC_Saida
  usecase "Registrar venda" as UC_Venda
  usecase "Baixar estoque automaticamente" as UC_BaixaAutomatica

  usecase "Gerenciar produtos\ne variações" as UC_GerenciarCatalogo
  usecase "Gerenciar fornecedores" as UC_GerenciarFornecedores
  usecase "Gerenciar usuários" as UC_GerenciarUsuarios
}

Visitante --> UC_PrimeiroAcesso
Visitante --> UC_CriarAdminInicial
Visitante --> UC_Login

Funcionario --> UC_Painel
Funcionario --> UC_Produtos
Funcionario --> UC_EstoqueBaixo
Funcionario --> UC_Movimentacoes
Funcionario --> UC_Relatorios
Funcionario --> UC_ConsultarFornecedores
Funcionario --> UC_ConsultarVendas
Funcionario --> UC_Entrada
Funcionario --> UC_Saida
Funcionario --> UC_Venda

Admin --> UC_GerenciarCatalogo
Admin --> UC_GerenciarFornecedores
Admin --> UC_GerenciarUsuarios

UC_Venda .> UC_BaixaAutomatica : <<include>>

note right of Admin
  O administrador herda os
  casos de uso operacionais
  do funcionário e adiciona
  as ações de gestão.
end note

note bottom of UC_GerenciarCatalogo
  Inclui cadastrar, editar e excluir
  produtos e suas variações.
end note

@enduml
